{
  "mcp": {
    "servers": {
      "context7": {
        "command": "/bin/zsh",
        "args": ["-c", "source ~/.nvm/nvm.sh && exec npx -y @upstash/context7-mcp"]
      },
      "playwright": {
        "command": "/bin/zsh",
        "args": ["-c", "source ~/.nvm/nvm.sh && exec npx -y @playwright/mcp@latest"]
      },
      "chrome-devtools": {
        "command": "/bin/zsh",
        "args": ["-c", "source ~/.nvm/nvm.sh && exec npx -y chrome-devtools-mcp@latest"]
      }
    }
  }
}
