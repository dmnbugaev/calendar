# === UniCalendar: переменные окружения ===
# Скопируйте в .env для локальной разработки (`cp .env.example .env`) и
# задайте те же значения в Vercel → Settings → Environment Variables.
# Файл .env не коммитится.

# --- PostgreSQL (Supabase) ---
# Pooled-подключение (pgBouncer, transaction mode, порт 6543) —
# используется рантаймом на Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Прямое подключение (порт 5432) — только для миграций drizzle-kit.
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"

# --- Google OAuth 2.0 (Cloud Console → Credentials) ---
NUXT_OAUTH_GOOGLE_CLIENT_ID="<client_id>.apps.googleusercontent.com"
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="<client_secret>"
# Опционально: redirect URI строго как зарегистрирован в Google Console.
# Локально можно не задавать — вычисляется из хоста запроса.
# Production: https://calendar.dmbugaev.ru/api/auth/google/callback
# Development: http://localhost:3000/api/auth/google/callback
# NUXT_OAUTH_GOOGLE_REDIRECT_URI=""

# --- Владелец приложения ---
# Только этот email может подключить Google-аккаунт и запускать синхронизацию.
NUXT_OWNER_EMAIL="you@example.com"

# --- Секреты сервера ---
# Генерация: openssl rand -base64 32
NUXT_SESSION_SECRET="<случайная строка, минимум 16 символов>"
# Ключ шифрования refresh token (AES-256-GCM). Менять после первого
# подключения нельзя — токен станет нерасшифруемым (нужно переподключение).
NUXT_TOKEN_ENCRYPTION_KEY="<случайная строка, минимум 16 символов>"
